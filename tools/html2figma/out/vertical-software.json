{"n":"Vertical Software","w":1440,"c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"text","t":"FULLSTEAM","fs":18,"fw":"Bold","ff":"sans","lc":"#000000","ls":0.4,"nm":"Logo"},{"k":"text","t":"Explore vertical solutions","fs":15,"fw":"Regular","ff":"sans","lc":"#000000","nm":"nav-right"}],"g":12,"nm":"nav"}],"d":"row","nm":"Nav","al":"center","jc":"space-between"}],"p":[12,24,12,24],"bg":"#FFFFFF","bd":{"c":"#000000","w":1,"dash":0,"s":"bottom"},"nm":"Header","mh":84},{"k":"frame","c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"frame","c":[{"k":"text","t":"Vertical Software","fs":11,"fw":"Bold","ff":"mono","lc":"#000000","up":1,"ls":1.4,"nm":"Beat"},{"k":"text","t":"Intent: lead with industry-specific, mission-critical software.","fs":56,"fw":"Bold","ff":"sans","lc":"#000000","fd":1,"lh":1.05,"ls":-1.5,"mw":760,"nm":"H1"},{"k":"text","t":"Software first. Fullsteam owns the system of record an industry runs on — the software a business opens every morning, not a horizontal platform stretched to fit. One industry's workflows, rules, and customers, built by people who know them.","fs":18,"fw":"Regular","ff":"sans","lc":"#000000","mw":560,"nm":"Lede"},{"k":"anno","t":"Software first — this is the point of the page, not AI or payments. Contrast with a general horizontal provider: here the software is the operating core of one industry, and the people who build it know that industry. The top of the page carries the customer photos and the product screenshots together as one opening statement; each vertical's story below repeats the full content set. Primary lens: investors; founders secondary. Not child pages; deep link is the hash (e.g. #retail).","lc":"#000000"},{"k":"pill","t":"Read the story","fs":16,"pad":[14,28,14,28]}],"g":12,"nm":"div"},{"k":"frame","c":[{"k":"frame","c":[{"k":"ph","mh":180,"nm":"Image placeholder"},{"k":"text","t":"Customer photo — the industry at work [placeholder]","fs":15,"fw":"Regular","ff":"sa