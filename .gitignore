.DS_Store

# Agent/tool scratch output — not project artifacts
.playwright-mcp/
.qwen/

# Cursor mirrored plan copies — plans/ is the single source of truth
.cursor/plans/

# Pages staging dir (built by .github/workflows/pages.yml, never committed)
_site/

# Design exploration sandbox — LOCAL ONLY. Unreviewed visual/interaction
# explorations live here and must not be client-facing. Ignored so they can
# never reach the public repo (raw.githubusercontent.com) or the Pages
# allowlist. See 03_Design/explorations/README.md for the rules + promotion path.
03_Design/explorations/

# Confidential client source docs — do NOT commit to this public repo
# This repo is PUBLIC. Since 2026-09-25 Pages publishes an explicit allowlist
# (index.html + 02_Wireframes/, staged in the workflow) rather than the repo root,
# so a tracked file is no longer automatically downloadable from
# mattybotstew.github.io. It IS still readable on raw.githubusercontent.com, so
# ignoring is still the control that matters. See PROJECT_KNOWLEDGE_BASE.md §22.7.
clientDocs/
# Individual entries kept for history (the blanket rule above covers them):
clientDocs/Fullsteam Overview_Confidential - redacted.pdf
clientDocs/Fullsteam User Interview Template.xlsx
clientDocs/Fullsteam Strategic Messaging Architecture V2.docx

# Third-party reference media — LOCAL ONLY, never commit.
# Pulled from reference sites (e.g. the Square hero video) for layout study only.
# This repo is PUBLIC and raw.githubusercontent.com serves any tracked file, so
# someone else's copyrighted video must not be committed here. Reference media is
# for internal study; it is not licensed for reuse in the Fullsteam build.
# See inspiration.md §2.2 for the source URL of each pull.
03_Design/assets/reference/

